<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_bs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lineamin"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!--caminar al origen-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_walk"
            app:tint="#757575"/>
        <TextView
            android:id="@+id/tv_bs_walk_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/camina"
            android:textSize="15sp"
            android:textColor="#616161"/>
    </LinearLayout>

    <!-- Parada Origen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bus_stop"
            app:tint="?attr/colorPrimary"/>
        <TextView
            android:id="@+id/tv_bs_origin_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/paradao"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Espera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_timer"
            app:tint="#66BB6A"/>
        <TextView
            android:id="@+id/tv_bs_wait_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/espera"
            android:textSize="15sp"
            android:textColor="#616161"/>
    </LinearLayout>

    <!-- Trayecto Bus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bus"
            app:tint="?attr/colorPrimary"/>
        <TextView
            android:id="@+id/tv_bs_ride_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/trayectobus"
            android:textSize="15sp"
            android:textColor="#616161"/>
    </LinearLayout>

    <!-- Parada Destino -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bus_stop"
            app:tint="?attr/colorPrimary"/>
        <TextView
            android:id="@+id/tv_bs_dest_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/paradad"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Caminar al destino -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_walk"
            app:tint="#757575"/>
        <TextView
            android:id="@+id/tv_bs_walk_dest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/hastad"
            android:textSize="15sp"
            android:textColor="#616161"/>
    </LinearLayout>

    <View
        android:id="@+id/divider_bs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_bs_next_buses_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proxbus"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_bs_next_buses_values"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--'  •  --'  •  --'"
        android:textSize="18sp"
        android:textColor="#66BB6A"
        android:textStyle="bold"/>

</LinearLayout>